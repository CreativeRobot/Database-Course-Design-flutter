@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle stickman
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #475569
}

actor 游客 as Visitor
actor 普通用户 as Customer
actor 管理员 as Admin

rectangle "在线书店系统" {
  package "公共浏览与认证" {
    usecase "注册账号" as Register
    usecase "登录系统" as Login
    usecase "浏览图书" as Browse
    usecase "搜索图书" as Search
    usecase "查看图书详情" as Detail
    usecase "查看图书评价" as ViewReview
    usecase "查看推荐图书" as Recommend
  }

  package "用户购书与个人中心" {
    usecase "管理购物车" as Cart
    usecase "提交订单" as CreateOrder
    usecase "模拟支付" as MockPay
    usecase "查看订单详情" as ViewOrders
    usecase "取消订单" as Cancel
    usecase "确认收货" as Confirm
    usecase "申请售后/退款" as Refund
    usecase "提交/修改评价" as Review
    usecase "管理个人资料" as Profile
    usecase "管理收货地址" as Address
    usecase "修改密码" as Password
    usecase "退出登录" as Logout
  }

  package "管理员后台" {
    usecase "查看经营概览" as Overview
    usecase "图书管理" as BookManage
    usecase "作者管理" as AuthorManage
    usecase "出版社管理" as PublisherManage
    usecase "分类管理" as CategoryManage
    usecase "订单管理与发货" as OrderManage
    usecase "评价审核" as ReviewManage
    usecase "库存流水查询" as InventoryLog
    usecase "用户管理" as UserManage
    usecase "售后审核" as RefundReview
  }
}

Visitor --> Register
Visitor --> Login
Visitor --> Browse
Visitor --> Search
Visitor --> Detail
Visitor --> ViewReview

Customer --> Browse
Customer --> Search
Customer --> Detail
Customer --> ViewReview
Customer --> Recommend
Customer --> Cart
Customer --> CreateOrder
Customer --> MockPay
Customer --> ViewOrders
Customer --> Cancel
Customer --> Confirm
Customer --> Refund
Customer --> Review
Customer --> Profile
Customer --> Address
Customer --> Password
Customer --> Logout

Admin --> Overview
Admin --> BookManage
Admin --> AuthorManage
Admin --> PublisherManage
Admin --> CategoryManage
Admin --> OrderManage
Admin --> ReviewManage
Admin --> InventoryLog
Admin --> UserManage
Admin --> RefundReview

CreateOrder .> Cart : <<include>>
CreateOrder .> Address : <<include>>
MockPay .> CreateOrder : <<extend>>
Refund .> ViewOrders : <<extend>>
Review .> ViewOrders : <<extend>>
OrderManage .> InventoryLog : <<include>>
@enduml

